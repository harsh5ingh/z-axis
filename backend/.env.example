PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000
APP_ENV=development

# Optional GeoVISTA Guided Assistant LLM. Copy this template to .env and add
# your own key locally; never put provider keys in frontend/.env or source control.
LLM_PROVIDER=groq

GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-120b

LLM_MAX_REQUESTS_PER_MINUTE=10
LLM_MAX_REQUESTS_PER_DAY=100
LLM_MAX_INPUT_CHARS=1200
LLM_MAX_OUTPUT_TOKENS=350